# ==============================================================================
# <ShopNest> Multi-Vendor E-Commerce Platform — Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origins (comma-separated list, trimmed, e.g. https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Public Backend URL (used for payment webhook callbacks, e.g. https://your-backend.onrender.com)
BACKEND_PUBLIC_URL=http://localhost:5000

# Dev & Sandbox Flags (ENABLE_FAKE_PAY must be false in production)
ENABLE_FAKE_PAY=false
PAYMENT_PROVIDER=mock
MOCK_GATEWAY_SECRET=mock_gateway_secret_key_32bytes_sample
MOCK_WEBHOOK_SECRET=mock_webhook_secret_key_32bytes_sample
MOCK_WEBHOOK_ENABLED=true

# Database & Cache
# Local development:
# MONGO_URI=mongodb://127.0.0.1:27017/marketplace
# REDIS_URL=redis://127.0.0.1:6379
# Production (MongoDB Atlas & Upstash Redis):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marketplace?retryWrites=true&w=majority
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
MONGO_URI=mongodb://127.0.0.1:27017/marketplace
REDIS_URL=redis://127.0.0.1:6379

# Elasticsearch (OPTIONAL: if ES_NODE is empty, app uses MongoDB fallback)
# Local: ES_NODE=http://127.0.0.1:9200
# Elastic Cloud: ES_NODE=https://<deployment-name>.es.<region>.gcp.cloud.es.io:9243
# ES_API_KEY=your_elastic_cloud_api_key_here
# or ES_USERNAME=elastic / ES_PASSWORD=your_elastic_password
ES_NODE=http://127.0.0.1:9200
ES_INDEX=products
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=

# Authentication (JWT)
# Generate high-entropy 64+ character random strings in production
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Cookie Settings
# Production values:
# - With Vercel /api proxy rewrite: COOKIE_SAMESITE=lax and COOKIE_SECURE=true
# - For direct cross-site calls (no proxy): COOKIE_SAMESITE=none and COOKIE_SECURE=true
# Local development:
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# File Storage (Supabase S3-Compatible Storage or AWS S3)
# For Supabase Storage:
# AWS_REGION=ap-south-1 (or your Supabase project region, e.g. us-east-1)
# AWS_BUCKET=marketplace-images
# AWS_ACCESS_KEY_ID=<your-project-ref-id>
# AWS_SECRET_ACCESS_KEY=<supabase-storage-s3-access-key>
# S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://<your-project-ref>.supabase.co/storage/v1/object/public/marketplace-images
# For Local MinIO:
AWS_REGION=us-east-1
AWS_BUCKET=marketplace-images
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# Razorpay (Live / Route Provider - Optional)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Administrator Account Initial Seed
ADMIN_EMAIL=admin@marketplace.com
ADMIN_PASSWORD=Admin@123456

# Demo Seeding Flag (default false; requires --yes flag on remote MONGO_URI)
ALLOW_DEMO_SEED=false
