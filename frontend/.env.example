# ==============================================================================
# <ShopNest> Multi-Vendor E-Commerce Platform — Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# - In local development: http://localhost:5000/api
# - In production with Vercel/Netlify proxy rewrite: /api (defaults automatically to /api in production)
VITE_API_URL=/api

# Direct Backend URL on Render (e.g. https://shopnest-backend.onrender.com)
# Used ONLY for fire-and-forget background warm-up ping to wake up free Render instance early on app load
VITE_BACKEND_URL=https://YOUR-BACKEND.onrender.com
